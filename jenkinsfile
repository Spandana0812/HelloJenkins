pileline{
    agent any
    stages{
        stage('compile'){
            steps{
                
                  bat 'javac hello.java'
            
            }
        }
        stage('Run'){
            steps{
                
                    bat 'java hello'
            
            }
        }
    }
    post{
        success{
            echo 'BUILD SUCCESSFUL'
        }
        failure{
            echo 'BUILD FAILED'
        }
    }
}